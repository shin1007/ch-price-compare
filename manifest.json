{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2026.10.1",
  "default_locale": "ja",
  "description": "__MSG_appDescription__",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "128": "icon.png"
    }
  }
}
